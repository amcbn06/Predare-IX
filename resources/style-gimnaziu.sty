\ProvidesPackage{style-gimnaziu}

% --- Encoding & language ---
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[english]{babel}

% --- Math ---
\usepackage{amsmath, amssymb}

% --- Code listings ---
\usepackage{listings}
\usepackage{xcolor}

\definecolor{codebg}{RGB}{245,245,245}
\definecolor{codecomment}{RGB}{100,100,100}
\definecolor{codekeyword}{RGB}{0,0,180}
\definecolor{codestring}{RGB}{163,21,21}

\lstset{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\scriptsize,
  keywordstyle=\color{codekeyword}\bfseries,
  commentstyle=\color{codecomment}\itshape,
  stringstyle=\color{codestring},
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=8pt,
  showspaces=false,
  showstringspaces=false,
  breaklines=true,
  frame=single,
  rulecolor=\color{gray!40},
  captionpos=b,
  language=C++,
  tabsize=4
}

% --- Graphics ---
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{arrows.meta, positioning, shapes, calc}

% --- Tables ---
\usepackage{booktabs}
\usepackage{array}

% --- Hyperlinks ---
\usepackage{hyperref}
\hypersetup{colorlinks=true, urlcolor=blue!70!black}

% --- Beamer font, color & spacing ---
\makeatletter
\@ifclassloaded{beamer}{%
  % Color scheme: forest green + warm orange
  \definecolor{gmGreen}{HTML}{276749}
  \definecolor{gmOrange}{HTML}{C05621}

  \setbeamercolor{palette primary}{bg=gmGreen, fg=white}
  \setbeamercolor{alerted text}{fg=gmOrange}
  \setbeamercolor{example text}{fg=gmGreen!80!black}
  \setbeamercolor{progress bar}{fg=gmOrange}

  % Uniform font size across blocks and itemize
  \setbeamerfont{block body}{size=\normalsize}
  \setbeamerfont{block title}{size=\normalsize, series=\bfseries}
  \setbeamerfont{itemize/enumerate body}{size=\normalsize}
  \setbeamerfont{itemize/enumerate subbody}{size=\normalsize}

  % Tighter bullet points
  \setlength{\leftmargini}{1.2em}
  \setlength{\leftmarginii}{1em}
  \setlength{\itemsep}{2pt}
  \setlength{\parskip}{0pt}
}{}
\makeatother
